FROM golang:1.25-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./

COPY . .
COPY vendor ./vendor
RUN CGO_ENABLED=0 go build -mod=vendor -o /metrics-service ./controlplane/cmd/metrics-service

FROM alpine:3.22
RUN apk add --no-cache ca-certificates
COPY --from=builder /metrics-service /metrics-service
COPY --from=builder /app/controlplane/settings /settings
ENV METRIC_CONTROLLER_PORT=8084
ENV HYPOTHESISLOOP_CONFIG=/settings/hypothesisloop.yaml
EXPOSE 8084
CMD ["/metrics-service"]
