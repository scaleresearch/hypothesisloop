FROM golang:1.25-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./

COPY . .
COPY vendor ./vendor
RUN CGO_ENABLED=0 go build -mod=vendor -o /control-service ./controlplane/cmd/control-service

FROM alpine:3.22
RUN apk add --no-cache ca-certificates
COPY --from=builder /control-service /control-service
COPY --from=builder /app/controlplane/settings /settings
COPY --from=builder /app/controlplane/shared/db/schema.sql /schema/schema.sql
ENV API_PORT=8081
ENV HYPOTHESISLOOP_CONFIG=/settings/hypothesisloop.yaml
EXPOSE 8081
CMD ["/control-service"]
