# The compiler runs on the build host and cross-compiles, so building for another platform
# does not emulate it.
FROM --platform=$BUILDPLATFORM golang:1.25-alpine AS builder
ARG TARGETOS TARGETARCH
WORKDIR /app
COPY go.mod go.sum ./

COPY . .
COPY vendor ./vendor
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -mod=vendor -o /control-service ./controlplane/cmd/control-service

FROM alpine:3.22
RUN apk add --no-cache ca-certificates
COPY --from=builder /control-service /control-service
COPY --from=builder /app/controlplane/settings /settings
COPY --from=builder /app/controlplane/shared/db/schema.sql /schema/schema.sql
ENV API_PORT=8081
ENV HYPOTHESISLOOP_CONFIG=/settings/hypothesisloop.yaml
EXPOSE 8081
CMD ["/control-service"]
