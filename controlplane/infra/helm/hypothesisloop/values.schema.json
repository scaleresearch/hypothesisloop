{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "namespace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "registry": {
          "type": "string"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "tag": {
          "type": "string"
        }
      }
    },
    "secretName": {
      "type": "string"
    },
    "secretChecksum": {
      "type": "string"
    },
    "chartChecksum": {
      "type": "string"
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "identityProviders": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "issuer": {
                "type": "string",
                "minLength": 1
              },
              "audience": {
                "type": "string",
                "minLength": 1
              },
              "jwt_keys": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "kid": {
                      "type": "string"
                    },
                    "kty": {
                      "type": "string"
                    },
                    "alg": {
                      "type": "string"
                    },
                    "crv": {
                      "type": "string"
                    },
                    "x": {
                      "type": "string"
                    },
                    "y": {
                      "type": "string"
                    },
                    "n": {
                      "type": "string"
                    },
                    "e": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "kid",
                    "kty",
                    "alg"
                  ]
                },
                "minItems": 1
              }
            },
            "required": [
              "issuer",
              "audience",
              "jwt_keys"
            ]
          }
        },
        "uiOrigin": {
          "type": "string"
        }
      }
    },
    "agents": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "launcher": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$|^$"
        },
        "image": {
          "type": "string"
        }
      }
    },
    "publicAPIURL": {
      "type": "string"
    },
    "runtimes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "metricsURL": {
          "type": "string"
        }
      }
    },
    "postgres": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "user": {
          "type": "string"
        },
        "database": {
          "type": "string"
        },
        "image": {
          "type": "string"
        },
        "storage": {
          "type": "string"
        },
        "storageClassName": {
          "type": "string"
        },
        "resources": {
          "type": "object"
        }
      }
    },
    "greptimedb": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "type": "string"
        },
        "storage": {
          "type": "string"
        },
        "storageClassName": {
          "type": "string"
        },
        "resources": {
          "type": "object"
        },
        "external": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "url": {
              "type": "string"
            }
          }
        }
      }
    },
    "memgraph": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "type": "string"
        },
        "storage": {
          "type": "string"
        },
        "storageClassName": {
          "type": "string"
        },
        "resources": {
          "type": "object"
        },
        "external": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "url": {
              "type": "string"
            }
          }
        }
      }
    },
    "objectStore": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "endpoint": {
          "type": "string"
        },
        "controlPlaneEndpoint": {
          "type": "string"
        },
        "image": {
          "type": "string"
        },
        "storage": {
          "type": "string"
        },
        "storageClassName": {
          "type": "string"
        },
        "resources": {
          "type": "object"
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "NodePort",
                "ClusterIP",
                "LoadBalancer"
              ]
            },
            "nodePort": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        }
      }
    },
    "controlService": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "resources": {
          "type": "object"
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "NodePort",
                "ClusterIP",
                "LoadBalancer"
              ]
            },
            "nodePort": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        }
      }
    },
    "metricsService": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "resources": {
          "type": "object"
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "NodePort",
                "ClusterIP",
                "LoadBalancer"
              ]
            },
            "nodePort": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "supabaseURL": {
          "type": "string"
        },
        "supabasePublishableKey": {
          "type": "string"
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "resources": {
          "type": "object"
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "NodePort",
                "ClusterIP",
                "LoadBalancer"
              ]
            },
            "nodePort": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        }
      }
    },
    "cloudAgent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "config": {
          "type": "string"
        },
        "secretEnv": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        },
        "resources": {
          "type": "object"
        },
        "clusterName": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$|^$"
        },
        "org": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$|^$"
        },
        "shared": {
          "type": "boolean"
        }
      }
    },
    "agentLauncher": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "config": {
          "type": "string"
        },
        "secretEnv": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        },
        "resources": {
          "type": "object"
        }
      }
    },
    "github": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "appId": {
          "type": "integer",
          "minimum": 0
        },
        "appSlug": {
          "type": "string"
        },
        "clientId": {
          "type": "string"
        }
      }
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "baseURL": {
          "type": "string"
        },
        "allowHTTP": {
          "type": "boolean"
        },
        "username": {
          "type": "string"
        }
      }
    }
  }
}
