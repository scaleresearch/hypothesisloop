ents/schemas/StatusReport"},"type":"array"}},"required":["reports"],"type":"object"},"StatusReport":{"additionalProperties":false,"properties":{"admitted_accelerator_type":{"type":"string"},"admitted_machine":{"$ref":"#/components/schemas/JobMachine"},"admitted_node":{"type":"string"},"attempt":{"format":"int64","type":"integer"},"ended_at":{"format":"date-time","type":"string"},"experiment_id":{"type":"string"},"log_tail":{"items":{"type":"string"},"type":"array"},"message":{"type":"string"},"phase":{"type":"string"},"reason":{"type":"string"},"restart_count":{"format":"int32","type":"integer"},"scheduled_nodes":{"format":"int32","type":"integer"},"started_at":{"format":"date-time","type":"string"}},"required":["experiment_id","phase"],"type":"object"},"TopologySpec":{"additionalProperties":false,"properties":{"same_zone":{"type":"boolean"},"spread_across_hosts":{"type":"boolean"}},"type":"object"}},"securitySchemes":{"bearer":{"scheme":"bearer","type":"http"}}},"info":{"title":"hypothesisloop cluster-agent API","version":"1.0.0"},"openapi":"3.1.0","paths":{"/":{"get":{"description":"Every cluster that has ever polled, and whether its agent is connected right now.","operationId":"list-clusters","responses":{"200":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AllClusters"}}},"description":"OK"},"default":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorModel"}}},"description":"Error"}},"security":[{"bearer":[]}],"summary":"List clusters and their connectivity","tags":["cluster-agent"]}},"/{name}":{"delete":{"description":"The cluster's own runtime ends the cluster, as its owner does with DELETE /orgs/{id}/clusters/{name}: every job placed on it goes back to the queue, its settings and the identity bound to it are deleted, and its runtime token is refused from then on with reason cluster_not_registered. requeued names the jobs.","operationId":"cluster-detach","parameters":[{"in":"path","name":"name","required":true,"schema":{"type":"string"}}],"responses":{"200":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DetachAnswer"}}},"description":"OK"},"default":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorModel"}}},"description":"Error"}},"security":[{"bearer":[]}],"summary":"Detach this cluster","tags":["cluster-agent"]}},"/{name}/access":{"get":{"description":"Answers 204 to the runtime token of a registered cluster named name, and refuses any other token as every route here does. It records and changes nothing, so an installer's dry run asks it before anything is installed.","operationId":"cluster-access","parameters":[{"in":"path","name":"name","required":true,"schema":{"type":"string"}}],"responses":{"204":{"description":"No Content"},"default":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorModel"}}},"description":"Error"}},"security":[{"bearer":[]}],"summary":"Check this cluster's runtime token","tags":["cluster-agent"]}},"/{name}/builds/{key}":{"post":{"description":"outcome pushed makes the environment ready in the image the repository holds under digest; file fails it with log_tail as the file's fault; platform frees the build to be assigned again. Recorded only while the build of key is assigned to this cluster at attempt and still building; otherwise 409. file is the exception: the file is the key's, so it fails a build still building at attempt or a later one, wherever it was assigned again.","operationId":"cluster-build-report","parameters":[{"in":"path","name":"name","required":true,"schema":{"type":"string"}},{"in":"path","name":"key","required":true,"schema":{"type":"string"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/EnvironmentBuildReport"}}},"required":true},"responses":{"204":{"description":"No Content"},"default":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorModel"}}},"description":"Error"}},"security":[{"bearer":[]}],"summary":"Report the outcome of an assigned environment build","tags":["cluster-agent"]}},"/{name}/builds/{key}/credential":{"post":{"description":"A login that writes to the environment repository for at least 25 minutes, handed out only while the build of key is assigned to this cluster at attempt and still building; otherwise 409.","operationId":"cluster-build-credential","parameters":[{"in":"path","name":"name","required":true,"schema":{"type":"string"}},{"in":"path","name":"key","required":true,"schema":{"type":"string"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/EnvironmentBuildCredentialRequest"}}},"required":true},"responses":{"200":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/RegistryLogin"}}},"description":"OK"},"default":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorModel"}}},"description":"Error"}},"security":[{"bearer":[]}],"summary":"The push login of an assigned environment build","tags":["cluster-agent"]}},"/{name}/builds/{key}/git-credential":{"post":{"description":"The git proxy address the repository whose environment file this is is read at, the repository's own address, and a platform token that reads that repository alone through the proxy, read-only, while the build of key is assigned to this cluster at attempt and still building. The build mounts them as the git config secret git-credentials of a RUN that asks for it, never into a layer. Handed out only while the build is assigned and building; otherwise 409. 404 for an environment of no repository: the build then mounts no secret.","operationId":"cluster-build-git-credential","parameters":[{"in":"path","name":"name","required":true,"schema":{"type":"string"}},{"in":"path","name":"key","required":true,"schema":{"type":"string"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/EnvironmentBuildCredentialRequest"}}},"required":true},"responses":{"200":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/EnvironmentGitCredential"}}},"description":"OK"},"default":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorModel"}}},"description":"Error"}},"security":[{"bearer":[]}],"summary":"A read of the repository an assigned environment build is of","tags":["cluster-agent"]}},"/{name}/builds/{key}/loaded":{"post":{"description":"The image of the build, the repository's under digest, is in the image store of node while its push goes on: a job that waits for the environment and fits on that node is placed there, pinned to it, and runs the image from there before it is pushed. The outcome is still reported once the push ends. Recorded only while the build of key is assigned to this cluster at attempt and still building; otherwise 409.","operationId":"cluster-build-loaded","parameters":[{"in":"path","name":"name","required":true,"schema":{"type":"string"}},{"in":"path","name":"key","required":true,"schema":{"type":"string"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/EnvironmentBuildLoaded"}}},"required":true},"responses":{"204":{"description":"No Content"},"default":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorModel"}}},"description":"Error"}},"security":[{"bearer":[]}],"summary":"Report an assigned environment build held on one node","tags":["cluster-agent"]}},"/{name}/builds/{key}/progress":{"post":{"description":"step, one line of at most 512 bytes, replaces the last one reported, and the jobs waiting for the environment show it. Recorded only while the build of key is assigned to this cluster at attempt and still building; otherwise 409.","operationId":"cluster-build-progress","parameters":[{"in":"path","name":"name","required":true,"schema":{"type":"string"}},{"in":"path","name":"key","required":true,"schema":{"type":"string"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/EnvironmentBuildProgress"}}},"required":true},"responses":{"204":{"description":"No Content"},"default":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorModel"}}},"description":"Error"}},"security":[{"bearer":[]}],"summary":"Report the step an assigned environment build is at","tags":["cluster-agent"]}},"/{name}/reconcile":{"post":{"description":"Atomically records one complete actual-capacity snapshot in metrics storage, keeping only priced accelerator types, then returns the complete PostgreSQL desired workload set for this cluster, plus the ids of workloads whose termination earns them their declared checkpoint window, the environment builds assigned to this cluster (builds, recorded as building only for a runtime that reports builds true), and registry_pull, a login that reads environment images, when a listed workload runs in one. The version the agent sends in X-Hypothesisloop-Agent-Version is kept with the snapshot, and a refusal of the request is kept as the cluster's last error until one is accepted.","operationId":"cluster-reconcile","parameters":[{"in":"path","name":"name","required":true,"schema":{"type":"string"}},{"in":"header","name":"X-Hypothesisloop-Agent-Version","schema":{"type":"string"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ReconcileRequest"}}},"required":true},"responses":{"200":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ReconcileAnswer"}}},"description":"OK"},"default":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorModel"}}},"description":"Error"}},"security":[{"bearer":[]}],"summary":"Exchange actual capacity for desired workloads","tags":["cluster-agent"]}},"/{name}/status":{"post":{"description":"Body: {\"reports\": [...]}. The complete snapshot is validated and written atomically; any invalid report rejects the whole request.","operationId":"cluster-push-status","parameters":[{"in":"path","name":"name","required":true,"schema":{"type":"string"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/StatusPush"}}},"required":true},"responses":{"200":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/StatusAck"}}},"description":"OK"},"default":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorModel"}}},"description":"Error"}},"security":[{"bearer":[]}],"summary":"Push job-phase observations from a cluster-agent","tags":["cluster-agent"]}}}}