{
  "name": "hypothesisloop-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node e2e/run.mjs",
    "types": "npm run types:api && npm run types:cluster-agent",
    "types:api": "openapi-typescript ../cmd/control-service/testdata/openapi.json -o src/types/api.ts --root-types --root-types-no-schema-prefix --root-types-keep-casing --enum-values",
    "types:cluster-agent": "openapi-typescript ../cmd/control-service/testdata/clusters-openapi.json -o src/types/cluster-agent-api.ts --root-types --root-types-no-schema-prefix --root-types-keep-casing --enum-values"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "@tanstack/react-table": "^8.21.3",
    "@xyflow/react": "^12.12.0",
    "clsx": "^2.1.0",
    "lucide-react": "^0.368.0",
    "next": "14.2.35",
    "react": "^18",
    "react-dom": "^18",
    "recharts": "^2.12.0",
    "swr": "^2.2.5"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "^10.4.0",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.35",
    "jsdom": "26.1.0",
    "openapi-typescript": "7.13.0",
    "playwright": "1.63.0",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.0",
    "typescript": "^5",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    },
    "source-map-js": "^1.2.2"
  }
}
