# What the UI serves with, read from the environment when the server starts, which refuses to
# start without one (next.config.mjs). All are public values, handed to every browser. Local
# development writes them from the root .env into localdev/.run/env/ui.env (localdev/envfiles);
# the chart sets them from its values.

# The control plane's API, as the browser reaches it.
UI_API_URL=http://localhost:8081

# The service that signs people in. One of:
#   supabase  a Supabase project.
IDENTITY_PROVIDER=supabase

# supabase: the project's URL and publishable key, from Project Settings, API.
IDENTITY_SUPABASE_URL=https://your-project-ref.supabase.co
IDENTITY_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# The sign-in providers the sign-in page offers, in this order: github, google, apple. Each must
# also be switched on in the sign-in service, for supabase in the project (Authentication, Sign In / Providers); one that is
# listed here and off there is offered and then reported as not available.
IDENTITY_SIGN_IN_PROVIDERS=github,google,apple
