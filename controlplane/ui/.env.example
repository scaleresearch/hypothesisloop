# Copy to .env.local and fill in. All are public values, compiled into the browser bundle.

# The control plane's API, as the browser reaches it.
NEXT_PUBLIC_API_URL=http://localhost:8081

# The service that signs people in. One of:
#   supabase  a Supabase project.
NEXT_PUBLIC_IDENTITY_PROVIDER=supabase

# supabase: the project's URL and publishable key, from Project Settings, API.
NEXT_PUBLIC_IDENTITY_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_IDENTITY_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# The sign-in providers the sign-in page offers, in this order: github, google, apple. Each must
# also be switched on in the sign-in service, for supabase in the project (Authentication, Sign In / Providers); one that is
# listed here and off there is offered and then reported as not available.
NEXT_PUBLIC_SIGN_IN_PROVIDERS=github,google,apple
