# Copy to .env.local and fill in. All three are public values, compiled into the browser bundle.

# The control plane's API, as the browser reaches it.
NEXT_PUBLIC_API_URL=http://localhost:8081

# The Supabase project that signs people in: Project Settings, API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
