# Local-only files (secrets, machine-specific notes) -- suffix with .local
*.local
*.local.*

# Go
/bin/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
coverage.txt
coverage.html

# Compiled service binaries in repo root
/control-service
/metrics-service
/node-agent
/cluster-agent

# Go workspace
go.work
go.work.sum

# Build output
dist/

# Next.js
controlplane/ui/.next/
controlplane/ui/.next-e2e/
controlplane/ui/out/
controlplane/ui/node_modules/
controlplane/ui/.env.local
controlplane/ui/.env.development.local
controlplane/ui/.env.test.local
controlplane/ui/.env.production.local
controlplane/ui/npm-debug.log*
controlplane/ui/yarn-debug.log*
controlplane/ui/yarn-error.log*
controlplane/ui/tsconfig.tsbuildinfo

# Python
**/__pycache__/
**/*.pyc
**/.venv/
**/venv/
**/wandb/
**/outputs/
**/checkpoints/
*.pt
*.pth
*.ckpt

# k3s
localdev/**/kubeconfig
*.kubeconfig
*.pem
*.key
*.crt

# Docker / secrets
.env
.env.*
!.env.example
docker-compose.override.yml

# Editor
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# OS
Thumbs.db

# Logs
*.log
logs/

# Secrets / credentials
*.secret
secrets/

# Go module vendor directory (not tracked)
vendor/
# Claude Code session state (worktrees, local agent scratch)
.claude/

# Experiment working clones: each is its own upstream git repo (source, datasets,
# vendored toolchains) cloned in place, not content of this repo. Only template,
# dummy-tt-matmul, dummy-data-search-demo, sparse-sdpa, and shampoo-family-optimizers are
# tracked as reference/example/active experiments.
agents/coordinator/experiments/*/
!agents/coordinator/experiments/template/
!agents/coordinator/experiments/dummy-tt-matmul/
!agents/coordinator/experiments/dummy-data-search-demo/
!agents/coordinator/experiments/sparse-sdpa/
!agents/coordinator/experiments/shampoo-family-optimizers/
controlplane/settings/.hypothesisloop.rendered.yaml
controlplane/settings/.hypothesisloop.dev.yaml
localdev/.bin/
localdev/.run/
localdev/.host-address
localdev/.image-tag
controlplane/infra/helm/hypothesisloop/files/hypothesisloop.yaml
local.secrets.env

# Pulumi local state and stack config (stack config holds secrets)
infra/.state/
infra/pulumi/Pulumi.*.yaml
# What a plain `go build` in infra/pulumi leaves: the program, named after its directory
infra/pulumi/pulumi
