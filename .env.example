# The inputs of local development: every secret, address and account that the make targets and
# localdev/ read. Copy to .env (git-ignored, mode 600) and fill in. A shell reads the file, so write each value in single quotes: KEY='value'. A value
# may span lines, as a PEM does.
#
# Each role the platform has a provider for is one key, <ROLE>_PROVIDER, naming the provider, and
# keys <ROLE>_<PROVIDER>_<FIELD> that only that provider reads (README.md, Configuration). Every
# provider here is the platform's own: a customer brings compute through the product instead.

# The registry the deployment's images are pushed to and pulled from. Every image is pulled with no
# credentials, except environment images, which go to a private repository beside it and are read
# only with a login control-service hands out. Set, local development builds environments there
# too: make render-settings writes the environments section of its settings from these keys.
# Empty: no registry, and local development builds no environments. One of:
#   gcp  Google Artifact Registry. Environments go to <repository>-environments.
CONTAINER_REGISTRY_PROVIDER=''
# gcp: the Google Cloud project that holds the repository, its location (such as europe-west1) and
# its name.
CONTAINER_REGISTRY_GCP_PROJECT=''
CONTAINER_REGISTRY_GCP_LOCATION=''
CONTAINER_REGISTRY_GCP_REPOSITORY=''

# The tag `make dev-hosted` runs the agent image and the job images under, as published to the
# registry above.
IMAGE_TAG=''

# Who signs people in on the local stack beside the key made on this machine, which the e2e suite
# and the browser run sign their users with and which is always accepted there. Empty: nobody
# else. One of:
#   supabase  a Supabase project, for signing in with GitHub in a browser.
IDENTITY_PROVIDER=''
# supabase: the project, the ref in its URL.
IDENTITY_SUPABASE_PROJECT_REF=''

# Where hosted agents run under `make dev-hosted`. One of:
#   fly  Fly.io machines.
#   e2b  E2B sandboxes. The agent image needs a template (runtime/cloud/settings/provider.e2b.yaml).
SANDBOX_PROVIDER='fly'
# fly: the app the machines run in, a deploy token of it (fly tokens create deploy -a <app>) which
# agent-launcher runs with, and a token that lists and stops the app's machines, for
# tests/e2e/test_real_providers.py.
SANDBOX_FLY_APP=''
SANDBOX_FLY_DEPLOY_TOKEN=''
SANDBOX_FLY_API_TOKEN=''
# e2b: the team API key, which `go run ./runtime/cloud/cmd/e2b-template` also takes, as E2B_API_KEY.
SANDBOX_E2B_API_KEY=''

# Whose models hosted agents run on under `make dev-hosted`. One of:
#   anthropic  Claude, through Claude Code.
MODEL_PROVIDER='anthropic'
# anthropic: the Claude subscription token hosted agents run with.
MODEL_ANTHROPIC_OAUTH_TOKEN=''

# Where cloud-agent rents GPU instances for jobs under `make dev-hosted`, as the cluster
# hypothesisloop-<provider> shared with every org. One of:
#   vast  vast.ai (runtime/cloud/settings/cloud-agent.vast.yaml).
CLOUD_COMPUTE_PROVIDER='vast'
# vast: the API key cloud-agent rents with, and that account's user id as the console shows it.
CLOUD_COMPUTE_VAST_API_KEY=''
CLOUD_COMPUTE_VAST_ACCOUNT_ID=''

# The GitHub App projects' repositories are reached through: its number, with the four keys below.
# A deployment needs all five. Local development with the id left empty reads none of
# them and keeps its code on a git server `make dev` runs on this machine
# (make git-repository NAME=... makes a repository there).
GITHUB_APP_ID=''
# The name in the App's URL (github.com/apps/<slug>).
GITHUB_APP_SLUG=''
# The App's OAuth client id, from its settings page.
GITHUB_APP_CLIENT_ID=''
# A client secret generated on the App's settings page.
GITHUB_APP_CLIENT_SECRET=''
# A private key generated on the App's settings page: the whole PEM.
GITHUB_APP_PRIVATE_KEY=''

# For `make test-github-live` only: an installation of the App, and a repository it covers that
# tests may push branches to (owner/name).
HL_E2E_GITHUB_INSTALLATION=''
HL_E2E_GITHUB_REPO=''
# An installation of the App on an organisation that lets it create repositories. Only
# HYPOTHESISLOOP_GITHUB_LIVE_CREATE=1 make test-github-live creates one there, which nothing
# deletes. On a personal account the owner's own token creates, which no live check holds.
HL_E2E_GITHUB_CREATE_INSTALLATION=''

# The clusters on the platform's own machines that the local stack registers for the org default
# beside local, separated by spaces or commas. Each is <name>:<provider>[:<field>=<value>]...,
# where provider is how the cluster runs:
#   k8s         a Kubernetes cluster, attached with make cluster-agent-up. Fields:
#                 context  the kube context this machine reaches it under. On a hardware host, the
#                          entry whose context is the host's (k3s-tt for make tt-up) names the
#                          cluster the host's suite runs on (make tt-e2e).
#                 node     the host's own node in it. Default: its k3s server node.
#   bare-metal  a node-agent on one host (hl cluster add --bare-metal prints its install command).
# Every provider takes silence_ceiling_seconds, the cluster's status silence ceiling, for a cluster
# whose link to the control plane drops for longer than the platform's default while its jobs keep
# running. Such as 'my-tt-box:k8s:context=k3s-tt:silence_ceiling_seconds=21600 my-gpu-host:k8s'.
# Empty: none.
OWNED_COMPUTE_CLUSTERS=''

# The local experiments under agents/coordinator/experiments that the experimentator image carries
# as samples beside hl-clone, separated by spaces or commas. all: every one this checkout holds.
# Empty: hl-clone alone.
EXPERIMENT_SAMPLES=''
