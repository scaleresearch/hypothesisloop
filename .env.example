# The inputs of one deployment: every secret, address and account that the make targets, local
# development and the maintainers' deployment tooling (not in this repository) read. Copy to .env (git-ignored, mode 600) and
# fill in. A shell reads the file, so write each value in single quotes: KEY='value'. A value
# may span lines, as a PEM does.

# The deployment tooling's stack name for this deployment. Local development does not read it.
STACK=''

# The Google account that administers the image registry, signed in with gcloud.
GCP_ACCOUNT=''
# The Google Cloud project that holds the Artifact Registry repository.
GCP_PROJECT=''
# The repository's location, such as europe-west1.
REGISTRY_LOCATION=''
# The repository's name. Every image is pulled from it with no credentials, except environment
# images, which go to <name>-environments and are read only with a token control-service hands out.
# Set, local development builds environments there too: make render-settings writes the
# environments section of its settings from these three keys.
REGISTRY_REPOSITORY=''
# The IAM members that may mint the tokens of the env-pusher and env-puller service accounts,
# comma-separated: the identity of GOOGLE_CREDENTIALS_FILE, and user:<GCP_ACCOUNT> for a control
# plane run locally with gcloud auth application-default login. Such as
# 'serviceAccount:control@my-project.iam.gserviceaccount.com,user:me@example.com'.
REGISTRY_TOKEN_MINTERS=''

# The Supabase project that signs people in and hosts the database: the ref in its URL.
SUPABASE_PROJECT_REF=''
# The session pooler's host: field db_host of GET /v1/projects/<ref>/config/database/pooler.
SUPABASE_POOLER_HOST=''
# A Supabase personal access token, which sets the project's auth settings.
SUPABASE_ACCESS_TOKEN=''
# The password of the project's postgres role.
SUPABASE_DB_PASSWORD=''
# The project's publishable key. Public: the browser sends it with every sign-in.
SUPABASE_PUBLISHABLE_KEY=''
# The sign-in providers the login page offers, in order and comma-separated: github, google,
# apple. Compiled into the UI image. Each must also be switched on in the Supabase project.
SIGN_IN_PROVIDERS=''
# The GitHub OAuth App people sign in through: its client id.
GITHUB_OAUTH_CLIENT_ID=''
# That OAuth App's client secret.
GITHUB_OAUTH_CLIENT_SECRET=''

# Where people open the UI, as scheme://host[:port]. The one browser origin the API answers,
# where Supabase returns a person after sign-in, and the base of the GitHub App's setup and
# callback URLs (<UI_ORIGIN>/settings/repository).
UI_ORIGIN=''
# The API as a browser reaches it. Compiled into the UI image.
API_ORIGIN=''

# The Fly.io organization that owns the app agent machines run in.
FLY_ORG=''
# That app's name. Created on a private network of its own.
FLY_APP=''
# The name of that network.
FLY_NETWORK=''
# An organization token ("FlyV1 ..."), used only to create the app.
FLY_API_TOKEN=''
# A deploy token of the app (fly tokens create deploy -a <app>), which agent-launcher runs with.
FLY_DEPLOY_TOKEN=''

# true adds the cluster part: namespace, Secret and helm release. Empty or false leaves it out.
DEPLOY_CLUSTER=''
# true adds cloud-agent and agent-launcher, which rent compute and cost money. Needs DEPLOY_CLUSTER.
DEPLOY_RUNTIMES=''
# The kubeconfig file that holds the cluster.
KUBECONFIG_FILE=''
# The context in that file. Named, so no other cluster of the file is touched.
KUBE_CONTEXT=''
# The namespace the control plane is installed in.
KUBE_NAMESPACE=''
# The image tag to deploy, and the one `make dev-hosted` runs the agent image and the job images
# under, as the deployment tooling published them.
IMAGE_TAG=''
# The API as rented instances, agent machines and other clusters reach it.
PUBLIC_API_URL=''
# metrics-service as they reach it.
PUBLIC_METRICS_URL=''
# The object store as they reach it.
PUBLIC_OBJECT_STORE_URL=''
# control-service's own Google identity: an application default credentials file, a service
# account key or a workload identity federation config, of a member of REGISTRY_TOKEN_MINTERS.
GOOGLE_CREDENTIALS_FILE=''

# The vast.ai API key cloud-agent rents with.
VAST_API_KEY=''
# That vast.ai account's user id, as the console shows it.
VAST_ACCOUNT_ID=''
# The E2B team API key, for the e2b provider and `go run ./runtime/cloud/cmd/e2b-template`.
E2B_API_KEY=''
# Which of the two runs hosted agents under `make dev-hosted`: fly or e2b. On e2b the agent image
# needs a template (runtime/cloud/settings/provider.e2b.yaml).
HOSTED_SANDBOX_PROVIDER='fly'
# The Claude subscription token hosted agents run with.
CLAUDE_CODE_OAUTH_TOKEN=''

# The GitHub App projects' repositories are reached through: its number, with the four keys below.
# A deployment needs all five. Local development with the id left empty reads none of
# them and keeps its code on a git server `make dev` runs on this machine
# (make git-repository NAME=... makes a repository there).
GITHUB_APP_ID=''
# The name in the App's URL (github.com/apps/<slug>).
GITHUB_APP_SLUG=''
# The App's OAuth client id, from its settings page.
GITHUB_APP_CLIENT_ID=''
# A client secret generated on the App's settings page.
GITHUB_APP_CLIENT_SECRET=''
# A private key generated on the App's settings page: the whole PEM.
GITHUB_APP_PRIVATE_KEY=''

# For `make test-github-live` only: an installation of the App, and a repository it covers that
# tests may push branches to (owner/name).
HL_E2E_GITHUB_INSTALLATION=''
HL_E2E_GITHUB_REPO=''
# An installation of the App on an organisation that lets it create repositories. Only
# HYPOTHESISLOOP_GITHUB_LIVE_CREATE=1 make test-github-live creates one there, which nothing
# deletes. On a personal account the owner's own token creates, which no live check holds.
HL_E2E_GITHUB_CREATE_INSTALLATION=''

# Who signs people in on the local stack beside the key made on this machine, which the e2e suite
# and the browser run sign their users with and which is always accepted there. Empty: nobody
# else. supabase: the project named by SUPABASE_PROJECT_REF as well, for signing in with GitHub in
# a browser.
LOCAL_IDENTITY_PROVIDER=''
