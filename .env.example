# The inputs of one deployment: every secret, address and account that the make targets, local
# development and the Pulumi program in infra/ read. Copy to .env (git-ignored, mode 600) and
# fill in. A shell reads the file, so write each value in single quotes: KEY='value'. A value
# may span lines, as a PEM does.

# The Pulumi stack this deployment's state is kept under, in infra/.state.
STACK=''

# The Google account that administers the image registry, signed in with gcloud.
GCP_ACCOUNT=''
# The Google Cloud project that holds the Artifact Registry repository.
GCP_PROJECT=''
# The repository's location, such as europe-west1.
REGISTRY_LOCATION=''
# The repository's name. Every image is pulled from it with no credentials.
REGISTRY_REPOSITORY=''

# The Supabase project that signs people in and hosts the database: the ref in its URL.
SUPABASE_PROJECT_REF=''
# The session pooler's host: field db_host of GET /v1/projects/<ref>/config/database/pooler.
SUPABASE_POOLER_HOST=''
# A Supabase personal access token, which sets the project's auth settings.
SUPABASE_ACCESS_TOKEN=''
# The password of the project's postgres role.
SUPABASE_DB_PASSWORD=''
# The project's publishable key. Public: the browser sends it with every sign-in.
SUPABASE_PUBLISHABLE_KEY=''
# The GitHub OAuth App people sign in through: its client id.
GITHUB_OAUTH_CLIENT_ID=''
# That OAuth App's client secret.
GITHUB_OAUTH_CLIENT_SECRET=''

# Where people open the UI, as scheme://host[:port]. The one browser origin the API answers,
# where Supabase returns a person after sign-in, and the base of the GitHub App's setup and
# callback URLs (<UI_ORIGIN>/settings/repository).
UI_ORIGIN=''
# The API as a browser reaches it. Compiled into the UI image.
API_ORIGIN=''

# The Fly.io organization that owns the app agent machines run in.
FLY_ORG=''
# That app's name. Created on a private network of its own.
FLY_APP=''
# The name of that network.
FLY_NETWORK=''
# An organization token ("FlyV1 ..."), used only to create the app.
FLY_API_TOKEN=''
# A deploy token of the app (fly tokens create deploy -a <app>), which agent-launcher runs with.
FLY_DEPLOY_TOKEN=''

# true adds the cluster part: namespace, Secret and helm release. Empty or false leaves it out.
DEPLOY_CLUSTER=''
# true adds cloud-agent and agent-launcher, which rent compute and cost money. Needs DEPLOY_CLUSTER.
DEPLOY_RUNTIMES=''
# The kubeconfig file that holds the cluster.
KUBECONFIG_FILE=''
# The context in that file. Named, so no other cluster of the file is touched.
KUBE_CONTEXT=''
# The namespace the control plane is installed in.
KUBE_NAMESPACE=''
# The image tag to deploy, as `make -C infra publish` printed it. The registry keeps what this
# names and the newest publish, and deletes every other version (infra/README.md).
IMAGE_TAG=''
# The API as rented instances, agent machines and other clusters reach it.
PUBLIC_API_URL=''
# metrics-service as they reach it.
PUBLIC_METRICS_URL=''
# The object store as they reach it.
PUBLIC_OBJECT_STORE_URL=''

# The vast.ai API key cloud-agent rents with.
VAST_API_KEY=''
# That vast.ai account's user id, as the console shows it.
VAST_ACCOUNT_ID=''
# The E2B team API key, for the e2b provider and `make -C infra e2b-template`.
E2B_API_KEY=''
# Which of the two runs hosted agents under `make dev-hosted`: fly or e2b. Nothing else changes
# with it. On e2b the agent image needs a template first (`make -C infra e2b-template`).
HOSTED_SANDBOX_PROVIDER='fly'
# The Claude subscription token hosted agents run with.
CLAUDE_CODE_OAUTH_TOKEN=''

# The GitHub App projects' repositories are reached through: its number. Left empty, the
# deployment and local development have no App and the four keys below are not read. Set, all
# four are required.
GITHUB_APP_ID=''
# The name in the App's URL (github.com/apps/<slug>).
GITHUB_APP_SLUG=''
# The App's OAuth client id, from its settings page.
GITHUB_APP_CLIENT_ID=''
# A client secret generated on the App's settings page.
GITHUB_APP_CLIENT_SECRET=''
# A private key generated on the App's settings page: the whole PEM.
GITHUB_APP_PRIVATE_KEY=''

# For `make e2e-github` and `make test-github-live` only: an installation of the App, and a
# repository it covers that tests may push branches to (owner/name).
HL_E2E_GITHUB_INSTALLATION=''
HL_E2E_GITHUB_REPO=''

# Who signs people in on the local stack beside the key made on this machine, which the e2e suite
# and the browser run sign their users with and which is always accepted there. Empty: nobody
# else. supabase: the project named by SUPABASE_PROJECT_REF as well, for signing in with GitHub in
# a browser.
LOCAL_IDENTITY_PROVIDER=''
