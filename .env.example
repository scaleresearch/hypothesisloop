# The inputs of local development: every secret, address and account that the make targets and
# localdev/ read. Copy to .env (git-ignored, mode 600) and fill in. A shell reads the file, so write each value in single quotes: KEY='value'. A value
# may span lines, as a PEM does.
#
# Each role the platform has a provider for is one key, <ROLE>_PROVIDER, naming the provider, and
# keys <ROLE>_<PROVIDER>_<FIELD> that only that provider reads, the role named as the section of
# the settings is (README.md, Configuration). A secret is named so in the program that reads it and
# in the chart's Secret too. Every
# provider here is the platform's own: a customer brings compute through the product instead.
#
# A secret has the same name here as in the program that reads it. make render-settings writes each
# program its own file of the keys it reads (localdev/.run/env/<program>.env), and each program
# refuses to start without one it needs, naming it.

# The registry the deployment's images are pushed to and pulled from, with no credentials. Set,
# experiments push the images their jobs run in to the same project and location, each org to a
# private repository of its own: make render-settings writes the container_registry section of its
# settings from these keys. Empty: no registry, and jobs run only in public images. One of:
#   gcp  Google Artifact Registry.
CONTAINER_REGISTRY_PROVIDER=''
# gcp: the Google Cloud project that holds the repository, its location (such as europe-west1) and
# its name.
CONTAINER_REGISTRY_GCP_PROJECT=''
CONTAINER_REGISTRY_GCP_LOCATION=''
CONTAINER_REGISTRY_GCP_REPOSITORY=''

# The tag `make dev` runs the agent image under, as published to the registry above.
IMAGE_TAG=''

# The address other machines, and the pods of their clusters, reach this machine at, for a
# cluster on another machine attached to the local stack (hl cluster add): an IPv4 address such as
# this machine's tailnet IP (tailscale ip -4). Use the IP and not a tailnet name, which pods do not
# resolve. Set, make render-settings hands it to every cluster, agent and job in place of the
# address local containers use: the API (:8081), the metrics service (:8084), the registry (:5000)
# and the chart in it, the object store (:9000), the git proxy (:8081/git) and the local git
# server (:8085). The registry is then published on it too (make dev or make registry-up), and
# serves plain HTTP: the attach command hl cluster add prints has the chart set every node's
# containerd to pull from it over HTTP. The local k3s cluster keeps its own route; its dev nodes
# learn the new name when they are made again (make full-start). Empty: only clusters on this
# machine can attach.
LOCAL_REACHABLE_ADDRESS=''

# Who signs people in on the local stack beside the key made on this machine, which the e2e suite
# and the browser run sign their users with and which is always accepted there. Empty: nobody
# else. One of:
#   supabase  a Supabase project, for signing in with GitHub in a browser.
IDENTITY_PROVIDER=''
# supabase: the project, the ref in its URL, and its publishable key (Project Settings, API), which
# the UI serves with.
IDENTITY_SUPABASE_PROJECT_REF=''
IDENTITY_SUPABASE_PUBLISHABLE_KEY=''
# The sign-in providers the UI's sign-in page offers, in this order: github, google, apple. Each
# must also be switched on in the project.
IDENTITY_SIGN_IN_PROVIDERS='github'

# The control-plane API's address as the browser running the UI reaches it, which the UI serves
# with. Required: make render-settings refuses without it.
UI_API_URL='http://localhost:8081'

# The browser origin the UI is served from, the one origin the API allows to call it. Required:
# make render-settings refuses without it.
UI_ORIGIN='http://localhost:3000'

# Where sandboxed agents run under `make dev`: one of the providers whose section
# controlplane/settings/sandbox.yaml holds, fly or e2b. Required. make dev renders that section,
# each of its values replaced by SANDBOX_<PROVIDER>_<FIELD> where .env sets one, and needs those
# its example leaves a placeholder, and the provider's account key, SANDBOX_<PROVIDER>_API_KEY.
SANDBOX_PROVIDER='fly'
# fly: the organization the machines run in (fly.org), the start of the name of the app each
# machine gets (fly.app_prefix), and a token of the organization (fly tokens create org -o <org>),
# which control-service rents with.
SANDBOX_FLY_ORG=''
SANDBOX_FLY_APP_PREFIX=''
SANDBOX_FLY_API_KEY=''
# e2b: the team API key. The sandbox instance needs a size e2b rents (controlplane/settings/sandbox.yaml).
SANDBOX_E2B_API_KEY=''

# The credentials of the model providers sandboxed agents run on (models in the settings), each
# provider served only while its key is set. No agent's machine is given any of them.
# anthropic: the Claude subscription token the control plane makes every call to an anthropic model
# with. Required: the settings' default models are anthropic's.
MODEL_ANTHROPIC_OAUTH_TOKEN=''
# openrouter: the OpenRouter API key the control plane makes every call to an openrouter model
# with. Optional: without it no openrouter model is served.
MODEL_OPENROUTER_API_KEY=''
# openai: the content of the auth.json of a Codex CLI signed in with ChatGPT (~/.codex/auth.json),
# whose tokens seed the ones the control plane makes every call to an openai model with; it renews
# them and keeps them in its database. Sign the Codex CLI in for the platform alone: a refresh token
# renews once. Optional: without it no openai model is served.
MODEL_OPENAI_AUTH_JSON=''

# The secret key of the object store's provider, minio in the settings' object_store section, also
# the compose MinIO's root password. A MinIO volume made before this key existed has the password
# 'hypothesisloop'.
OBJECT_STORE_MINIO_SECRET_ACCESS_KEY=''

# Where control-service rents GPU instances for jobs under `make dev`, as the cluster
# hypothesisloop-<provider> of the platform's org default, which serves every org's jobs: one of
# the providers whose section controlplane/settings/cloud-compute.yaml holds, vast or runpod. Its
# section is rendered as the sandbox's is, from CLOUD_COMPUTE_<CLUSTER_NAME>_<FIELD>, here
# CLOUD_COMPUTE_HYPOTHESISLOOP_<PROVIDER>_<FIELD>, with the account key
# CLOUD_COMPUTE_HYPOTHESISLOOP_<PROVIDER>_API_KEY.
CLOUD_COMPUTE_PROVIDER='vast'
# vast: the API key control-service rents with, and that account's user id as the console shows it
# (vast.account_id).
CLOUD_COMPUTE_HYPOTHESISLOOP_VAST_API_KEY=''
CLOUD_COMPUTE_HYPOTHESISLOOP_VAST_ACCOUNT_ID=''
# runpod: the API key control-service rents with, and that account's user id as the console shows
# it (runpod.account_id).
CLOUD_COMPUTE_HYPOTHESISLOOP_RUNPOD_API_KEY=''
CLOUD_COMPUTE_HYPOTHESISLOOP_RUNPOD_ACCOUNT_ID=''

# The git host local platform experiments keep their code on. Required: github, the GitHub App of
# the five GIT_HOST_GITHUB_* keys below, or plain, a git server `make dev` runs on this machine
# (a push or the platform creates a repository there), which reads none of them: its password is
# made on this machine and handed to it and the control plane as GIT_HOST_PLAIN_PASSWORD.
GIT_HOST_PROVIDER='plain'
# The App's number, from its settings page. A deployment's App is made from
# controlplane/clients/githost/github/app-manifest.json (README, GitHub).
GIT_HOST_GITHUB_APP_ID=''
# The name in the App's URL (github.com/apps/<slug>).
GIT_HOST_GITHUB_APP_SLUG=''
# A private key generated on the App's settings page: the whole PEM.
GIT_HOST_GITHUB_APP_PRIVATE_KEY=''
# The App's client ID and a client secret generated on its settings page. The App requests user
# authorization (OAuth) during installation, its callback URL the UI's /settings/repository.
GIT_HOST_GITHUB_CLIENT_ID=''
GIT_HOST_GITHUB_CLIENT_SECRET=''

# For the tests against github.com only (make test-github-live, make e2e, the UI run): an
# installation of the App, and a repository it covers that tests may push branches to
# (owner/name).
TEST_GIT_HOST_GITHUB_INSTALLATION=''
TEST_GIT_HOST_GITHUB_REPOSITORY=''
# An installation of the App, on an organisation or a personal account, that lets it create
# repositories. Only TEST_GIT_HOST_GITHUB_CREATE=1 make test-github-live creates one there, which
# nothing deletes.
TEST_GIT_HOST_GITHUB_CREATE_INSTALLATION=''

# The clusters on the platform's own machines that the local stack registers for the org default
# beside local, separated by spaces or commas. Each is <name>:<provider>[:<field>=<value>]...,
# where provider is how the cluster runs:
#   k8s         a Kubernetes cluster, attached with make cluster-agent-up. Fields:
#                 context  the kube context this machine reaches it under. On a hardware host, the
#                          entry whose context is the host's (k3s-tt for make tt-up) names the
#                          cluster the host's suite runs on (make tt-e2e).
#                 node     the host's own node in it. Default: its k3s server node.
#   bare-metal  a node-agent on one host (hl cluster add --bare-metal prints its install command).
# Every provider takes silence_ceiling_seconds, the cluster's status silence ceiling, for a cluster
# whose link to the control plane drops for longer than the platform's default while its jobs keep
# running. Such as 'my-tt-box:k8s:context=k3s-tt:silence_ceiling_seconds=21600 my-gpu-host:k8s'.
# Empty: none.
OWNED_COMPUTE_CLUSTERS=''
