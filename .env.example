# The inputs of local development: every secret, address and account that the make targets and
# localdev/ read. Copy to .env (git-ignored, mode 600) and fill in. A shell reads the file, so write each value in single quotes: KEY='value'. A value
# may span lines, as a PEM does.

# The Google Cloud project that holds the Artifact Registry repository.
GCP_PROJECT=''
# The repository's location, such as europe-west1.
REGISTRY_LOCATION=''
# The repository's name. Every image is pulled from it with no credentials, except environment
# images, which go to <name>-environments and are read only with a token control-service hands out.
# Set, local development builds environments there too: make render-settings writes the
# environments section of its settings from these three keys.
REGISTRY_REPOSITORY=''

# The Supabase project that signs people in: the ref in its URL.
SUPABASE_PROJECT_REF=''

# The Fly.io app hosted agent machines run in.
FLY_APP=''
# A Fly.io token that lists and stops the app's machines, for tests/e2e/test_real_providers.py.
FLY_API_TOKEN=''
# A deploy token of the app (fly tokens create deploy -a <app>), which agent-launcher runs with.
FLY_DEPLOY_TOKEN=''

# The tag `make dev-hosted` runs the agent image and the job images under, as published to the
# registry above.
IMAGE_TAG=''

# The vast.ai API key cloud-agent rents with.
VAST_API_KEY=''
# That vast.ai account's user id, as the console shows it.
VAST_ACCOUNT_ID=''
# The E2B team API key, for the e2b provider and `go run ./runtime/cloud/cmd/e2b-template`.
E2B_API_KEY=''
# Which of the two runs hosted agents under `make dev-hosted`: fly or e2b. On e2b the agent image
# needs a template (runtime/cloud/settings/provider.e2b.yaml).
HOSTED_SANDBOX_PROVIDER='fly'
# The Claude subscription token hosted agents run with.
CLAUDE_CODE_OAUTH_TOKEN=''

# The GitHub App projects' repositories are reached through: its number, with the four keys below.
# A deployment needs all five. Local development with the id left empty reads none of
# them and keeps its code on a git server `make dev` runs on this machine
# (make git-repository NAME=... makes a repository there).
GITHUB_APP_ID=''
# The name in the App's URL (github.com/apps/<slug>).
GITHUB_APP_SLUG=''
# The App's OAuth client id, from its settings page.
GITHUB_APP_CLIENT_ID=''
# A client secret generated on the App's settings page.
GITHUB_APP_CLIENT_SECRET=''
# A private key generated on the App's settings page: the whole PEM.
GITHUB_APP_PRIVATE_KEY=''

# For `make test-github-live` only: an installation of the App, and a repository it covers that
# tests may push branches to (owner/name).
HL_E2E_GITHUB_INSTALLATION=''
HL_E2E_GITHUB_REPO=''
# An installation of the App on an organisation that lets it create repositories. Only
# HYPOTHESISLOOP_GITHUB_LIVE_CREATE=1 make test-github-live creates one there, which nothing
# deletes. On a personal account the owner's own token creates, which no live check holds.
HL_E2E_GITHUB_CREATE_INSTALLATION=''

# Who signs people in on the local stack beside the key made on this machine, which the e2e suite
# and the browser run sign their users with and which is always accepted there. Empty: nobody
# else. supabase: the project named by SUPABASE_PROJECT_REF as well, for signing in with GitHub in
# a browser.
LOCAL_IDENTITY_PROVIDER=''

# The clusters on machines of their own that the local stack registers for the org default beside
# local, separated by spaces or commas. name:seconds also sets the cluster's status silence
# ceiling, for a cluster whose link to the control plane drops for longer than the platform's
# default while its jobs keep running. Such as 'my-tt-box:21600 my-gpu-host'. Empty: none.
LOCAL_EXTRA_CLUSTERS=''

# The local experiments under agents/coordinator/experiments that the experimentator image carries
# as samples beside hl-clone, separated by spaces or commas. all: every one this checkout holds.
# Empty: hl-clone alone.
EXPERIMENT_SAMPLES=''

# A Tenstorrent host's node and the cluster it is registered as, for the make tt-* targets.
# Empty: the k3s server node of the TT_CONTEXT cluster, and a cluster named after it.
TT_NODE=''
TT_CLUSTER=''
