# Default dockerignore for Go service builds
# Used by Dockerfile.control-service, Dockerfile.metrics-service,
# Dockerfile.node-agent, Dockerfile.cluster-agent

# Version control
.git/
.gitignore

# CI / editor
.github/
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Docs / specs
*.md
docs/

# UI (not needed in Go images)
controlplane/ui/

# Python workload (not needed in Go images)
tests/workload/
tests/workload-robotics/

# Infra definitions (not needed at runtime)
controlplane/infra/
runtime/k8s/infra/
localdev/
tests/*.sh

# Go test artifacts
*_test.go
coverage.txt
coverage.html
*.out

# Secrets / env
.env
.env.*
secrets/
*.secret
*.pem
*.key
*.crt

# Logs
*.log
logs/

# Per-experiment heavy/gitignored local state (datasets, tt-metal build trees, checkpoints) --
# huge (tens of GB for smri-fm) and never needed baked into an image: agents/experimentator's
# Dockerfile.base only needs experiment.md/seed/ text+scripts, and each experiment's own
# Dockerfile.experimentator clones tt-metal fresh at its own pin rather than reusing this copy.
agents/coordinator/experiments/*/datasets/
agents/coordinator/experiments/*/tenstorrent/tt-metal/
agents/coordinator/experiments/*/checkpoints/
