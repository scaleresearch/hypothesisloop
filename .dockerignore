# Default dockerignore for Go service builds
# Used by Dockerfile.control-service, Dockerfile.metrics-service,
# Dockerfile.node-agent, Dockerfile.cluster-agent

# Version control
.git/
.gitignore

# CI / editor
.github/
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Docs / specs
*.md
docs/

# UI (not needed in Go images)
controlplane/ui/

# Python workload (not needed in Go images)
tests/workload/
tests/workload-robotics/

# Infra definitions (not needed at runtime)
controlplane/infra/
runtime/k8s/infra/
localdev/
tests/*.sh

# Go test artifacts
*_test.go
coverage.txt
coverage.html
*.out

# Secrets / env
.env
.env.*
secrets/
*.secret
*.pem
*.key
*.crt

# Settings rendered for one machine's stack (git-ignored): an image runs on
# controlplane/settings/hypothesisloop.yaml, and these name a deployment's app ids and addresses.
controlplane/settings/.*.yaml

# Logs
*.log
logs/

# Per-experiment heavy/gitignored local state (datasets, tt-metal build trees, checkpoints) can
# reach tens of GB and is never needed baked into an image: agents/experimentator's
# Dockerfile.base only needs experiment.md/seed/ text+scripts, and each experiment's own
# Dockerfile.experimentator clones tt-metal fresh at its own pin rather than reusing this copy.
# ** rather than a fixed depth: an experiment's heavy state is not all at one level (checkpoints
# and generated kernels can sit in nested directories), which a single-star pattern walks
# straight past.
agents/coordinator/experiments/**/datasets/
agents/coordinator/experiments/**/tt-metal/
agents/coordinator/experiments/**/checkpoints/
agents/coordinator/experiments/**/generated/
agents/coordinator/experiments/**/wandb/
agents/coordinator/experiments/**/__pycache__/
# Per-run validation/reproduction output, gitignored the same way (see each experiment's own
# .gitignore: scratch_*/).
agents/coordinator/experiments/*/scratch_*/

# Agent worktrees and Python virtualenvs: copies of the repo and installed packages, over a
# gigabyte that every image's COPY wrote into the build VM and no image runs from.
.claude/
**/.venv/
