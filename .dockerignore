# Build context for every image built from the repository root

# Version control
.git/
.gitignore

# CI / editor
.github/
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Docs / specs. The built-in agent prompts are compiled into control-service.
*.md
!controlplane/domain/agenttypes/builtin/*.md
docs/

# UI (not needed in Go images)
controlplane/ui/

# Infra definitions (not needed at runtime)
controlplane/infra/
runtime/k8s/infra/
localdev/
tests/*.sh

# Go test artifacts
*_test.go
coverage.txt
coverage.html
*.out

# Secrets / env
.env
.env.*
**/*.secrets.env
secrets/
*.secret
*.pem
*.key
*.crt

# Settings rendered for one machine's stack (git-ignored): an image runs on
# controlplane/settings/hypothesisloop.yaml, and these name a deployment's app ids and addresses.
controlplane/settings/.*.yaml

# Logs
*.log
logs/

# Agent worktrees and Python virtualenvs: copies of the repo and installed packages, over a
# gigabyte that every image's COPY wrote into the build VM and no image runs from.
.claude/
**/.venv/

# Python caches
**/__pycache__/
**/*.pyc
