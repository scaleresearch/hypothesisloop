ANTHROPIC_API_KEY=
# Bare model ID, no provider prefix — the Claude Agent SDK talks to the Anthropic API directly,
# not OpenRouter. See shared/models.md in the claude-api skill for the current list; defaults to
# claude-sonnet-5 if unset.
ANTHROPIC_MODEL=claude-sonnet-5

# THE shared code repo, pre-created by the operator. Every agent clones this same repo and works
# on its own branch (agent-<AGENT_ID>). Must be a real remote pods can clone — code_ref =
# "<CODE_REPO_URL>@<sha>" is what a job pod checks out to run. Same model locally and in prod;
# locally a git:// remote works with no token.
# CODE_REPO_URL=https://github.com/scaleresearch/experiments
#
# Token for non-interactive clone/push (git credential helper). The agent also passes it into each
# job's env so the pod can clone. Required for a private repo; a local git:// remote needs none.
# GIT_TOKEN=
