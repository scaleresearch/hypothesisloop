# Shared base for every experiment's own experimentator image (see
# agents/coordinator/experiments/<name>/Dockerfile.experimentator, which FROMs this image and
# layers on that experiment's own runtime source/pins -- tt-metal today, but nothing here assumes
# that; a non-tt-metal experiment's overlay just skips that layer). Everything below is identical
# across experiments: the agent harness itself, git/Claude Code plumbing, and the read-only
# WORKLOAD_SAMPLES reference. Keep experiment-specific source/deps out of this file -- they belong
# in the per-experiment overlay so one experiment's pin bump can't silently change what every other
# experiment's agent reads.
#
# Thin, deliberately unopinionated: uv-managed deps (claude-agent-sdk bundles its own Claude
# Code CLI binary, no separate install needed) + curl (the agent will likely reach for it via
# its Bash tool anyway). No sandboxing of what the agent can do *inside* this container — the
# container boundary itself is the isolation, same as the request that led to this file.

# Builder stage for the Go `hl` CLI (cli/) -- the platform's own client. The agent uses it (not
# raw curl) for everything a human would do through it too: hl platform-experiments, hl hypothesis
# query/submit/link, hl job submit job.yaml, hl watch. Built from the repo root
# (build context — see Makefile `experimentator-base-image`), same module as the controlplane.
FROM --platform=$BUILDPLATFORM golang:1.25-bookworm AS hl-builder
ARG TARGETOS TARGETARCH
WORKDIR /src
COPY go.mod go.sum ./
COPY cli/ cli/
COPY runtime/shared/exitline/ runtime/shared/exitline/
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -o /out/hl ./cli

# Only each experiment's seed/ and hl-clone reach the agent: experiment.md carries coordinator
# notes agents must not read.
FROM --platform=$BUILDPLATFORM golang:1.25-bookworm AS samples
COPY agents/coordinator/experiments /samples
RUN find /samples -mindepth 2 -maxdepth 2 ! -name seed -exec rm -rf {} + \
	&& find /samples -mindepth 1 -maxdepth 1 -type f ! -name hl-clone -delete

FROM python:3.13-slim

# git: the agent pushes the exact code each job runs to its branch in the project's repository
# (system prompt step 5), so every experiment's code_ref resolves to a real, cloneable commit —
# that is the trace from a submitted job back to its source.
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates git \
    && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

# Non-interactive git auth, baked so the agent never handles credentials: git asks `hl
# git-credential` (the hl copied in below), which asks the platform for a token minted for that
# call and limited to the project's repository. Nothing is stored and no git token is in the
# environment. useHttpPath makes git name the repository, so the helper answers for that one only.
# Plus a default commit identity so commits don't fail on a fresh container, and a first push of
# a new branch that needs no -u.
RUN git config --system credential.https://github.com.helper '!hl git-credential' \
 && git config --system credential.https://github.com.useHttpPath true \
 && git config --system user.name  "hypothesisloop-agent" \
 && git config --system user.email "agent@hypothesisloop.local" \
 && git config --system init.defaultBranch main \
 && git config --system push.autoSetupRemote true

# permission_mode="bypassPermissions" (unrestricted tool use — the whole point of this agent)
# maps to the CLI's --dangerously-skip-permissions, which refuses to run as root/sudo as a
# safety guard — confirmed live: "cannot be used with root/sudo privileges". A non-root user is
# therefore required, not optional, for this container to start at all.
RUN useradd --create-home --shell /bin/bash agent

# WORKLOAD_SAMPLES is the agent's starting point for what a job workload looks like: every
# experiment's seed/ (not tests/workloads/, which is test-only fixture code) plus hl-clone. Read,
# copy, adapt into its own repo. Deliberately not experiment-specific.
ENV WORKLOAD_SAMPLES=/opt/workloads-samples
COPY --from=samples /samples $WORKLOAD_SAMPLES

# The `hl` CLI, built in the hl-builder stage above. This is how the agent talks to the platform
# for everything a human would use it for too -- hl platform-experiments
# create/start, hl hypothesis query/submit/link, hl job submit job.yaml, hl watch
# (`hl watch --experiment ID --until '...'` holds a websocket open and exits when the platform
# says the thing happened). A job image that
# wants it too can COPY it in the same way it copies a seed workload.
COPY --from=hl-builder /out/hl /usr/local/bin/hl

WORKDIR /agent
COPY agents/experimentator/pyproject.toml agents/experimentator/uv.lock .
RUN uv sync --no-dev --locked

COPY agents/experimentator/src/ src/
# No docs/ copy: the platform rules are fetched live at startup (api_client.PlatformClient.fetch_rules).
RUN mkdir -p /agent/workspace && chown -R agent:agent /agent
ENV AGENT_WORKDIR=/agent/workspace

# Pre-create ~/.claude owned by agent: bind-mounting a single file into a path whose parent
# directory doesn't exist yet (e.g. -v ~/.claude/.credentials.json:/home/agent/.claude/...:ro)
# makes the container runtime auto-create that directory as root:root, which then blocks the
# CLI's own writes under it (e.g. session-env) with a permission error. Also run with
# --userns=keep-id (see coordinator/instructions.md) so a bind-mounted host dotfile's owning
# UID actually matches the agent user inside the container instead of mapping to root.
RUN mkdir -p /home/agent/.claude && chown agent:agent /home/agent/.claude

USER agent
ENTRYPOINT ["uv", "run", "python3", "-m", "hypothesisloop_agent.claude.run"]
# A per-experiment overlay that needs to install/clone as root (e.g. tt-metal source) must
# `USER root` for that layer and switch back to `USER agent` itself afterwards -- ENTRYPOINT is
# inherited as-is and does not need repeating.
