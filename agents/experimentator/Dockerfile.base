# Shared base for every experiment's own experimentator image (see
# agents/coordinator/experiments/<name>/Dockerfile.experimentator, which FROMs this image and
# layers on that experiment's own runtime source/pins -- tt-metal today, but nothing here assumes
# that; a non-tt-metal experiment's overlay just skips that layer). Everything below is identical
# across experiments: the agent harness itself, git/Claude Code plumbing, and the read-only
# WORKLOAD_SAMPLES reference. Keep experiment-specific source/deps out of this file -- they belong
# in the per-experiment overlay so one experiment's pin bump can't silently change what every other
# experiment's agent reads.
#
# Thin, deliberately unopinionated: uv-managed deps (claude-agent-sdk bundles its own Claude
# Code CLI binary, no separate install needed) + curl (the agent will likely reach for it via
# its Bash tool anyway). No sandboxing of what the agent can do *inside* this container — the
# container boundary itself is the isolation, same as the request that led to this file.

# Builder stage for the Go `hl` CLI (cli/) -- the platform's own client. The agent uses it (not
# raw curl) for everything a human would do through it too: hl platform-experiments, hl hypothesis
# query/submit/link, hl job submit job.yaml, hl watch. Built from the repo root
# (build context — see Makefile `experimentator-base-image`), same module as the controlplane.
FROM --platform=$BUILDPLATFORM golang:1.25-bookworm AS hl-builder
ARG TARGETOS TARGETARCH
WORKDIR /src
COPY go.mod go.sum ./
COPY cli/ cli/
COPY contract/ contract/
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -o /out/hl ./cli

# Only hl-clone and the experiments EXPERIMENT_SAMPLES names (separated by spaces or commas, or
# all for every one this checkout holds) reach the agent, and of each only its seed/ and its job
# spec: experiment.md carries coordinator notes agents must not read. An experiment that holds
# neither leaves no directory.
FROM --platform=$BUILDPLATFORM golang:1.25-bookworm AS samples
ARG EXPERIMENT_SAMPLES=""
COPY agents/coordinator/experiments /samples
RUN keep=" $(printf '%s' "$EXPERIMENT_SAMPLES" | tr ',' ' ') " \
	&& for name in $keep; do \
		[ "$name" = all ] || [ -d "/samples/$name" ] || { echo "EXPERIMENT_SAMPLES names $name, which agents/coordinator/experiments does not hold" >&2; exit 1; }; \
	done \
	&& for dir in $(find /samples -mindepth 1 -maxdepth 1 -type d); do \
		case "$keep" in *" all "*|*" ${dir#/samples/} "*) ;; *) rm -rf "$dir" ;; esac; \
	done \
	&& find /samples -mindepth 2 -maxdepth 2 ! -name seed ! -name .hypothesisloop -exec rm -rf {} + \
	&& find /samples -mindepth 3 -maxdepth 3 -path '*/.hypothesisloop/*' ! -name job.yaml -delete \
	&& find /samples -mindepth 1 -maxdepth 1 -type f ! -name hl-clone -delete \
	&& find /samples -type d -empty -delete

# A stage of its own: a pull that fails here says why, and one that fails inside COPY --from
# reads as "no stage or image found with that name".
FROM ghcr.io/astral-sh/uv:latest AS uv

FROM python:3.13-slim

# git: the agent pushes the exact code each job runs to its branch in the project's repository
# (system prompt step 5), so every experiment's code_ref resolves to a real, cloneable commit —
# that is the trace from a submitted job back to its source.
# build-essential, pkg-config, cmake: an agent compiles and tests a harness here before a job runs
# it. Twice a baseline agent found no C compiler or linker.
# sudo: what else its .hypothesisloop/Dockerfile installs, the agent installs here itself.
# bubblewrap: hl env run runs a command inside the image a job runs in, staged by hl env stage,
# and fuse-overlayfs gives each working tree a copy-on-write view of it. fusermount3 unmounts
# through /etc/mtab, which the base image lacks.
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates git \
    build-essential pkg-config cmake sudo bubblewrap fuse-overlayfs \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /proc/self/mounts /etc/mtab
COPY --from=uv /uv /uvx /usr/local/bin/

# Non-interactive git auth, baked so the agent never handles a credential of the git host: the
# harness sends git for the repository to the platform's git proxy (git_url), and git asks `hl
# git-credential` (the hl copied in below) on whichever host it talks to. It answers the proxy's
# address alone, with the agent's own platform token; the proxy reaches the git host itself and
# refuses a push to any ref but the agent's own branches. Nothing is stored. useHttpPath makes git
# name the repository, so the helper stays silent for every other address.
# Plus a default commit identity so commits don't fail on a fresh container, and a first push of
# a new branch that needs no -u.
RUN git config --system credential.helper '!hl git-credential' \
 && git config --system credential.useHttpPath true \
 && git config --system user.name  "hypothesisloop-agent" \
 && git config --system user.email "agent@hypothesisloop.local" \
 && git config --system init.defaultBranch main \
 && git config --system push.autoSetupRemote true

# permission_mode="bypassPermissions" (unrestricted tool use — the whole point of this agent)
# maps to the CLI's --dangerously-skip-permissions, which refuses to run as root/sudo as a
# safety guard — confirmed live: "cannot be used with root/sudo privileges". A non-root user is
# therefore required, not optional, for this container to start at all. Its home is /agent,
# which holds the directory it works in and beside it only dotfiles: agents ran `cd ~` first and
# cloned in a home that held nothing, and the CLI put their shell back in the working directory,
# away from the clone.
# Passwordless sudo for all of it: apt-get or dpkg alone already run any script as root, so a
# narrower rule keeps nothing safe in a VM that holds one agent and is thrown away after it.
RUN useradd --home-dir /agent --shell /bin/bash agent \
 && echo 'agent ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/agent \
 && chmod 0440 /etc/sudoers.d/agent

# WORKLOAD_SAMPLES is the agent's starting point for what a job workload looks like: the seed/ of
# each experiment EXPERIMENT_SAMPLES names (not tests/workloads/, which is test-only fixture code)
# with the .hypothesisloop/job.yaml that runs it, plus hl-clone. Read, copy, adapt into its own repo.
# Deliberately not experiment-specific.
ENV WORKLOAD_SAMPLES=/opt/workloads-samples
COPY --from=samples /samples $WORKLOAD_SAMPLES
# The job DSL reference the samples and hl job submit --help name.
COPY controlplane/settings/examples/experiment-submission.yaml $WORKLOAD_SAMPLES/
# An agent reads the code a job ran with `hl-clone <code_ref> <dir>`, so it is a command here as
# it is in the job image.
RUN ln -s $WORKLOAD_SAMPLES/hl-clone /usr/local/bin/hl-clone

# The `hl` CLI, built in the hl-builder stage above: the one way the agent acts on the platform.
COPY --from=hl-builder /out/hl /usr/local/bin/hl

# The harness lives outside the agent's home: a home with src/ and pyproject.toml in it looks
# like the place to work.
# The agent owns it and installs into it as itself, so the environment is one layer that changes
# only with uv.lock: a chown after the install would write every file of it a second time.
RUN mkdir -p /agent/workspace /agent/.claude /agent/.harness /opt/hypothesisloop-agent \
 && chown -R agent:agent /agent /opt/hypothesisloop-agent
USER agent
# The agent's own Python: one virtualenv with pip in it, which the harness puts first on PATH
# (core.own_python), so `pip install`, `python3 -m pip install` and `uv pip install` all land where
# the agent's python3 reads. The harness's environment below is no place for it: uv run puts that
# one first, it has no pip, and the system pip installs to a user site it never reads.
ENV AGENT_VENV=/agent/.venv
RUN uv venv --seed --no-cache --python /usr/local/bin/python3 $AGENT_VENV
WORKDIR /opt/hypothesisloop-agent
# Every module is compiled to bytecode here: a machine that boots compiles what it imports
# otherwise, which took two of the harness's first four seconds on a Fly machine.
COPY --chown=agent:agent agents/experimentator/pyproject.toml agents/experimentator/uv.lock .
RUN uv sync --no-dev --locked --no-cache --compile-bytecode --no-install-project

# The harness itself is installed once its source is there. Installed before, it was recorded as
# built without src/, and every `uv run` of a new machine fetched the build backend and built it
# again before the harness started. `uv run` still builds it again on every boot (1.4 seconds
# measured), so nothing runs it: the entrypoint and the launcher's command start the
# environment's python directly.
COPY --chown=agent:agent agents/experimentator/src/ src/
RUN uv sync --no-dev --locked --no-cache --compile-bytecode \
 && .venv/bin/python3 -m compileall -q src
# No prompt in the image: the platform serves each agent its instructions, rules included (instructions.py).

# /agent/workspace is where the agent clones and works, and nothing else is ever written there:
# what a tool keeps under ~ (.cache, .claude, .local) and what the harness keeps (AGENT_STATE_DIR)
# lies beside it, so none of it can become an untracked file of the agent's repository.
# ~/.claude is created above and owned by agent: bind-mounting a single file into a path whose
# parent directory doesn't exist yet (e.g. -v ~/.claude/.credentials.json:/agent/.claude/...:ro)
# makes the container runtime auto-create that directory as root:root, which then blocks the
# CLI's own writes under it (e.g. session-env) with a permission error. Also run with
# --userns=keep-id so a bind-mounted host dotfile's owning UID
# actually matches the agent user inside the container instead of mapping to root.
ENV AGENT_WORKDIR=/agent/workspace
ENV AGENT_STATE_DIR=/agent/.harness
# Where the model CLI keeps its sessions, which the harness stores with the platform. The harness
# requires it, so that the two never differ on where a transcript is.
ENV CLAUDE_CONFIG_DIR=/agent/.claude

ENTRYPOINT ["/opt/hypothesisloop-agent/.venv/bin/python3", "-m", "hypothesisloop_agent.claude.run"]
# A per-experiment overlay that needs to install/clone as root (e.g. tt-metal source) must
# `USER root` for that layer and switch back to `USER agent` itself afterwards -- ENTRYPOINT is
# inherited as-is and does not need repeating.
