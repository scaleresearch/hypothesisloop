#!/usr/bin/env python3
"""hl-watch — block until the platform says something happened, then print it and exit.

A tool call is request/response: the model cannot hold a socket across turns, so it cannot wait
on one. It ends its turn instead, gets nudged, and re-reads whole state to learn nothing changed.
This process holds the socket on its behalf. One call replaces a hundred polling turns.

    hl-watch --experiment $ID --until 'status in COMPLETED,FAILED,EVICTED' --timeout 900

Every event is printed as one JSON line as it arrives, so the transcript shows what happened and
not merely that it did. The exit code says which way the wait ended, and is meant to be branched
on:

    0    --until became true. Without --until, the watch window simply elapsed.
    124  the timeout expired with --until still unmet — the same code /usr/bin/timeout uses.
    2    the request was wrong and would stay wrong: bad flags, or the platform refused the
         subscription (an unknown kind, an experiment that does not exist). Not retried, because
         a 4xx two seconds later is the same 4xx, and waiting on it is the silent block this
         tool exists to remove. The refusal's own message is printed.

Everything genuinely transient — a refused connection, a 5xx, a socket dropped mid-stream — is
retried until the timeout instead, because that retry is the feature.

A dropped connection is a delay, never a gap: this reconnects with the cursor of the last event it
saw, and the server replays what was missed before going live again.

Without --kinds you get the default subscription: everything an agent's loop would otherwise poll
for — your jobs and why they are stuck, your quota, your two stop conditions, the ladder, the
brief, and the shared pool. The one kind left out is metric.point, the highest-volume kind and a
pointer with no value in it; name it in --kinds when you are watching one job's progress.

Read-only. The only frame this sends up the socket asks about or re-scopes THIS connection's own
subscription (--show-subscription prints what the server says it is serving you), which changes
nothing on the platform. Nothing else sent up this socket does anything, and no event arriving on it instructs a job
to do anything — the control plane's decisions reach a runtime as desired state and by no other
path. A job may watch its own experiment; that is receiving, not self-reporting, so the rule that
a job pushes metrics and nothing else is untouched.

No dependencies: the platform's API images are whatever a workload happens to be built on, so this
speaks RFC 6455 over a plain socket rather than assuming a library is installed.
"""
from __future__ import annotations

import argparse
import base64
import json
import os
import socket
import ssl
import struct
import sys
import time
import urllib.parse

TIMEOUT_EXIT_CODE = 124
USAGE_EXIT_CODE = 2

# Long enough that an idle stream is not mistaken for a dead one (the server pings every 20s),
# short enough that a genuinely dead path is noticed and reconnected rather than waited out.
READ_TIMEOUT_S = 45.0
RECONNECT_DELAY_S = 2.0


class Closed(Exception):
    """The connection ended, or the server was momentarily unable. Reconnect and replay."""


class Refused(Exception):
    """The platform rejected this subscription. The request is wrong and will stay wrong."""


class WebSocket:
    def __init__(self, sock: socket.socket) -> None:
        self.sock = sock
        self.buffer = b""

    def read_exactly(self, n: int) -> bytes:
        while len(self.buffer) < n:
            chunk = self.sock.recv(65536)
            if not chunk:
                raise Closed("connection closed by peer")
            self.buffer += chunk
        out, self.buffer = self.buffer[:n], self.buffer[n:]
        return out

    def _send_frame(self, opcode: int, payload: bytes) -> None:
        # A client must mask every frame it sends.
        mask = os.urandom(4)
        header = bytes([0x80 | opcode])
        length = len(payload)
        if length <= 125:
            header += bytes([0x80 | length])
        elif length <= 0xFFFF:
            header += bytes([0x80 | 126]) + struct.pack("!H", length)
        else:
            header += bytes([0x80 | 127]) + struct.pack("!Q", length)
        masked = bytes(b ^ mask[i % 4] for i, b in enumerate(payload))
        self.sock.sendall(header + mask + masked)

    def send_text(self, text: str) -> None:
        self._send_frame(0x1, text.encode("utf-8"))

    def next_text(self) -> str:
        """Returns the next text frame, answering pings and skipping everything else."""
        while True:
            head = self.read_exactly(2)
            opcode = head[0] & 0x0F
            length = head[1] & 0x7F
            if length == 126:
                length = struct.unpack("!H", self.read_exactly(2))[0]
            elif length == 127:
                length = struct.unpack("!Q", self.read_exactly(8))[0]
            if head[1] & 0x80:
                mask = self.read_exactly(4)
                payload = bytes(b ^ mask[i % 4] for i, b in enumerate(self.read_exactly(length)))
            else:
                payload = self.read_exactly(length)
            if opcode == 0x8:
                raise Closed("server closed the stream")
            if opcode == 0x9:
                self._send_frame(0xA, payload)
                continue
            if opcode == 0x1:
                return payload.decode("utf-8")

    def close(self) -> None:
        try:
            self._send_frame(0x8, b"")
        except OSError:
            pass
        self.sock.close()


def connect(url: str, path: str) -> WebSocket:
    parsed = urllib.parse.urlparse(url)
    secure = parsed.scheme in ("https", "wss")
    port = parsed.port or (443 if secure else 80)
    sock = socket.create_connection((parsed.hostname, port), timeout=READ_TIMEOUT_S)
    if secure:
        sock = ssl.create_default_context().wrap_socket(sock, server_hostname=parsed.hostname)
    key = base64.b64encode(os.urandom(16)).decode()
    request = (
        f"GET {path} HTTP/1.1\r\n"
        f"Host: {parsed.hostname}:{port}\r\n"
        "Upgrade: websocket\r\n"
        "Connection: Upgrade\r\n"
        f"Sec-WebSocket-Key: {key}\r\n"
        "Sec-WebSocket-Version: 13\r\n\r\n"
    )
    sock.sendall(request.encode())
    ws = WebSocket(sock)
    while b"\r\n\r\n" not in ws.buffer:
        chunk = sock.recv(65536)
        if not chunk:
            raise Closed("server closed during the handshake")
        ws.buffer += chunk
    head, ws.buffer = ws.buffer.split(b"\r\n\r\n", 1)
    status = head.split(b"\r\n", 1)[0].decode()
    if " 101 " in status:
        return ws
    code = status_code(status)
    detail = read_body(ws, head)
    sock.close()
    # A 4xx says the request is wrong, and it will be just as wrong two seconds from now: a
    # mistyped kind or an experiment that does not exist never becomes retryable. Retrying it to
    # the timeout is the silent wait this tool exists to remove, so it is raised as fatal. A 5xx
    # or a refused connection is the opposite — the server is momentarily unable, not the request
    # invalid — and stays in the retry loop.
    if 400 <= code < 500:
        raise Refused(f"the platform refused this subscription: {status.strip()}{detail}")
    raise Closed(f"handshake failed: {status.strip()}{detail}")


def status_code(status_line: str) -> int:
    parts = status_line.split()
    if len(parts) < 2 or not parts[1].isdigit():
        return 0
    return int(parts[1])


def read_body(ws: WebSocket, head: bytes) -> str:
    """Returns the refusal's body, which is the only thing that says WHICH part was wrong.

    The platform answers every error in one {"error": "..."} envelope, so the body carries the
    name of the offending kind or id. A status line alone leaves the caller guessing.
    """
    length = 0
    for line in head.decode(errors="replace").split("\r\n")[1:]:
        name, _, value = line.partition(":")
        if name.strip().lower() == "content-length" and value.strip().isdigit():
            length = int(value.strip())
    try:
        if length:
            body = ws.read_exactly(length)
        else:
            body = ws.buffer
            while True:
                chunk = ws.sock.recv(65536)
                if not chunk:
                    break
                body += chunk
    except (OSError, Closed):
        body = ws.buffer
    text = body.decode(errors="replace").strip()
    try:
        message = json.loads(text).get("error", "")
    except (json.JSONDecodeError, AttributeError):
        message = text
    return f" — {message}" if message else ""


def parse_until(expression: str):
    """Turns 'status in A,B,C' into a predicate over one event.

    Exactly one form is understood, and an expression that is not that form is a usage error
    rather than a condition that quietly never fires — a wait that can never end is the failure
    this tool exists to remove.
    """
    parts = expression.split(None, 2)
    if len(parts) != 3 or parts[0] != "status" or parts[1] != "in":
        raise ValueError("--until must read: status in VALUE[,VALUE...]")
    wanted = {value.strip() for value in parts[2].split(",") if value.strip()}
    if not wanted:
        raise ValueError("--until names no values")

    def satisfied(event: dict) -> bool:
        return event.get("kind") == "experiment.status" and event.get("value") in wanted

    return satisfied


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Wait on platform events instead of polling for them.",
        epilog="exit codes:\n"
               "  0    --until became true, or (without --until) the watch window elapsed\n"
               "  124  the timeout expired with --until still unmet\n"
               "  2    the request was wrong and would stay wrong: bad flags, or the platform\n"
               "       refused the subscription (unknown kind, unknown experiment). Never\n"
               "       retried; a connection failure or a 5xx is retried until the timeout.\n",
        formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--experiment", default=os.environ.get("HYPOTHESISLOOP_EXPERIMENT_ID", ""),
                        help="watch one job (defaults to $HYPOTHESISLOOP_EXPERIMENT_ID)")
    parser.add_argument("--platform-experiment", default="", help="watch a whole platform experiment")
    parser.add_argument("--agent", default="", help="narrow job and quota events to this agent")
    parser.add_argument("--kinds", default="",
                        help="comma-separated event kinds; default is every kind marked default by "
                             "GET /watch/kinds (all but metric.point)")
    parser.add_argument("--show-subscription", action="store_true",
                        help="ask the server what this connection is actually subscribed to and print its answer")
    parser.add_argument("--until", default="",
                        help="stop when true; one form only: 'status in COMPLETED,FAILED,EVICTED'")
    parser.add_argument("--timeout", type=float, default=900.0, help="give up after this many seconds")
    parser.add_argument("--since", type=int, default=0, help="replay from this cursor before going live")
    parser.add_argument("--url", default=os.environ.get("HYPOTHESISLOOP_API_URL") or os.environ.get("API_URL", ""),
                        help="platform API base URL (defaults to $HYPOTHESISLOOP_API_URL, then $API_URL)")
    args = parser.parse_args()

    if not args.url:
        print("hl-watch: no API URL given and neither HYPOTHESISLOOP_API_URL nor API_URL is set", file=sys.stderr)
        return USAGE_EXIT_CODE
    if not args.experiment and not args.platform_experiment:
        print("hl-watch: one of --experiment or --platform-experiment is required", file=sys.stderr)
        return USAGE_EXIT_CODE
    satisfied = None
    if args.until:
        try:
            satisfied = parse_until(args.until)
        except ValueError as err:
            print(f"hl-watch: {err}", file=sys.stderr)
            return USAGE_EXIT_CODE

    query = {}
    if args.experiment:
        query["experiment_id"] = args.experiment
    if args.platform_experiment:
        query["platform_experiment_id"] = args.platform_experiment
    if args.agent:
        query["agent"] = args.agent
    if args.kinds:
        query["kinds"] = args.kinds

    deadline = time.monotonic() + args.timeout
    cursor = args.since
    while time.monotonic() < deadline:
        query["since"] = str(cursor) if cursor else ""
        path = "/watch?" + urllib.parse.urlencode({k: v for k, v in query.items() if v})
        try:
            ws = connect(args.url, path)
        except Refused as err:
            print(f"hl-watch: {err}", file=sys.stderr)
            return USAGE_EXIT_CODE
        except (OSError, Closed) as err:
            print(f"hl-watch: connect: {err}", file=sys.stderr)
            time.sleep(RECONNECT_DELAY_S)
            continue
        try:
            if args.show_subscription:
                ws.send_text("{}")
            while time.monotonic() < deadline:
                ws.sock.settimeout(min(READ_TIMEOUT_S, max(0.1, deadline - time.monotonic())))
                line = ws.next_text()
                print(line, flush=True)
                try:
                    event = json.loads(line)
                except json.JSONDecodeError:
                    continue
                # A widened subscription replays the kinds it added, and those carry cursors older
                # than ones already seen. The cursor to resume from is the highest, never the last:
                # handing back a lower one on reconnect would replay what is already in this
                # transcript.
                cursor = max(cursor, event.get("cursor") or 0)
                if satisfied and satisfied(event):
                    return 0
        except (OSError, Closed) as err:
            print(f"hl-watch: stream ended ({err}) — reconnecting from cursor {cursor}", file=sys.stderr)
            time.sleep(RECONNECT_DELAY_S)
        finally:
            ws.close()

    if satisfied:
        print(f"hl-watch: timed out after {args.timeout:g}s without: {args.until}", file=sys.stderr)
        return TIMEOUT_EXIT_CODE
    return 0


if __name__ == "__main__":
    sys.exit(main())
