FROM golang:1.25-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./

COPY . .
COPY vendor ./vendor
RUN CGO_ENABLED=0 go build -mod=vendor -o /cluster-agent ./cluster/cmd/cluster-agent

FROM alpine:3.19
RUN apk add --no-cache ca-certificates
COPY --from=builder /cluster-agent /cluster-agent
COPY --from=builder /app/controlplane/settings /settings
ENV OPENRESEARCH_CONFIG=/settings/openresearch.yaml
CMD ["/cluster-agent"]
