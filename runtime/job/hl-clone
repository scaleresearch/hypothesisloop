#!/bin/sh
# hl-clone [<url>@<sha>] [dir]   — defaults to $HYPOTHESISLOOP_CODE_REF and /workspace/code.
# <url> is the git address of the platform experiment's repository.
#
# `git clone --depth 1 --branch <sha>` does not work: a shallow clone can only name a ref, and a
# bare commit SHA is not one. Fetching the SHA into an empty repo is the form that does, and it is
# the reason this exists as a helper rather than as a line every agent rewrites from memory.
set -eu

ref="${1:-${HYPOTHESISLOOP_CODE_REF:-}}"
dir="${2:-/workspace/code}"

if [ -z "$ref" ]; then
	echo "hl-clone: no code ref given and HYPOTHESISLOOP_CODE_REF is unset" >&2
	exit 2
fi
case "$ref" in
*@*) ;;
*)
	echo "hl-clone: code ref must be <git-url>@<40-char-commit-sha>, got '$ref'" >&2
	exit 2
	;;
esac

# Exit codes: 2 for a code ref that is none, 1 where the repository answers and does not give the
# commit (it was never pushed), and 75 where neither the repository nor the platform's git proxy
# in front of it answered. 75 is domain.ExitCodeCodeUnreachable: the runtime reports the job as
# code_unreachable and the platform queues it again at no cost, since its command never ran.
#
# A job that cannot reach the repository or the platform's git proxy this second usually
# can a little later, so the fetch is tried $tries times, the pause doubling from 5 s up to 60 s:
# about three minutes in all.
tries=7
pause=5

# A job holds no credential of the git host: it fetches through the platform's git proxy at
# HYPOTHESISLOOP_GIT_URL with its own token, and a code_ref is only ever of that one repository.
# An agent's own git config sends the code_ref's address to the proxy.
remote="${ref%@*}"
if [ -n "${HYPOTHESISLOOP_GIT_URL:-}" ]; then
	remote="$HYPOTHESISLOOP_GIT_URL"
fi

mkdir -p "$dir"
git -C "$dir" init -q
try=1
while ! said=$(git -C "$dir" fetch -q --depth 1 "$remote" "${ref##*@}" 2>&1); do
	said=$(printf '%s' "$said" | tr '\n' ' ')
	if [ "$try" -eq "$tries" ]; then
		if git ls-remote -q "$remote" HEAD >/dev/null 2>&1; then
			echo "hl-clone: could not fetch the code: $tries tries to fetch ${ref##*@} from $remote failed and the repository answers, so the commit is not in it, the last with: $said" >&2
			exit 1
		fi
		echo "hl-clone: could not fetch the code: $tries tries failed and the repository or the platform's git proxy in front of it does not answer, so the command never ran and the platform queues the job again. Fetching ${ref##*@} from $remote, the last try said: $said" >&2
		exit 75
	fi
	echo "hl-clone: try $try of $tries to fetch the code failed, the next is in ${pause}s: $said" >&2
	try=$((try + 1))
	sleep "$pause"
	pause=$((pause * 2 > 60 ? 60 : pause * 2))
done
git -C "$dir" checkout -q FETCH_HEAD
echo "$dir"
