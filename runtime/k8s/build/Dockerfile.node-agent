# The compiler runs on the build host and cross-compiles, so building for another platform
# does not emulate it.
FROM --platform=$BUILDPLATFORM golang:1.25-alpine AS builder
ARG TARGETOS TARGETARCH
WORKDIR /app
COPY go.mod go.sum ./

COPY . .
COPY vendor ./vendor
RUN --mount=type=cache,target=/root/.cache/go-build CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -mod=vendor -o /node-agent ./runtime/k8s/cmd/node-agent

FROM alpine:3.22
RUN apk add --no-cache ca-certificates
COPY --from=builder /node-agent /node-agent
CMD ["/node-agent"]
