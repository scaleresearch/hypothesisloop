# The compiler runs on the build host and cross-compiles, so building for another platform
# does not emulate it.
FROM --platform=$BUILDPLATFORM golang:1.25-alpine AS builder
ARG TARGETOS TARGETARCH
ARG VERSION
WORKDIR /app
COPY go.mod go.sum ./

COPY . .
COPY vendor ./vendor
RUN --mount=type=cache,target=/root/.cache/go-build set -e; \
    [ -n "$VERSION" ] || { echo "build with --build-arg VERSION=<image tag>: the binary names the version it runs" >&2; exit 1; }; \
    CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -mod=vendor -ldflags "-X main.version=$VERSION" -o /cluster-agent ./runtime/k8s/cmd/cluster-agent

FROM alpine:3.22
RUN apk add --no-cache ca-certificates
COPY --from=builder /cluster-agent /cluster-agent
USER 65532:65532
CMD ["/cluster-agent"]
