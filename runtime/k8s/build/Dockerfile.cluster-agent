FROM golang:1.25-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./

COPY . .
COPY vendor ./vendor
RUN CGO_ENABLED=0 go build -mod=vendor -o /cluster-agent ./runtime/k8s/cmd/cluster-agent

FROM alpine:3.22
RUN apk add --no-cache ca-certificates
COPY --from=builder /cluster-agent /cluster-agent
COPY --from=builder /app/controlplane/settings /settings
ENV HYPOTHESISLOOP_CONFIG=/settings/hypothesisloop.yaml
CMD ["/cluster-agent"]
