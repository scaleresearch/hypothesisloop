FROM golang:1.25-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./

COPY . .
COPY vendor ./vendor
RUN CGO_ENABLED=0 go build -mod=vendor -o /agent-launcher ./runtime/cloud/cmd/agent-launcher

FROM alpine:3.22
RUN apk add --no-cache ca-certificates
COPY --from=builder /agent-launcher /agent-launcher
CMD ["/agent-launcher"]
